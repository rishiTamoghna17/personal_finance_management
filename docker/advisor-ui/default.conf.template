# Temporary local test page for the advisor (M6), until the Phase 2 app exists. Published on 127.0.0.1 only.
# The bridge API token is added here, so it never appears in the page. Only three read-only advisor routes pass.
server {
    listen 80;
    client_max_body_size 64k;
    root /usr/share/nginx/html;

    location = / { try_files /index.html =404; }

    location ~ ^/api/v1/(chat|digest|alerts)$ {
        proxy_pass http://bridge:8000;
        proxy_set_header Host bridge;
        proxy_set_header Authorization "Bearer ${BRIDGE_API_TOKEN}";
        proxy_read_timeout 200s;
    }

    location / { return 404; }
}
