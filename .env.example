# Copy to .env with:  sh scripts/init-env.sh
# That script fills every __GENERATE__ value with a random secret.
# .env is gitignored. Never commit it.

# --- PostgreSQL (one server, two databases, two roles) ---
POSTGRES_PASSWORD=__GENERATE__
FIREFLY_DB_NAME=firefly
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=__GENERATE__
BRIDGE_DB_NAME=bridge
BRIDGE_DB_USER=bridge
BRIDGE_DB_PASSWORD=__GENERATE__

# --- Firefly III ---
# APP_KEY and STATIC_CRON_TOKEN must be exactly 32 characters.
FIREFLY_APP_KEY=__GENERATE__
FIREFLY_STATIC_CRON_TOKEN=__GENERATE__
FIREFLY_APP_URL=http://localhost:8080
FIREFLY_SITE_OWNER=owner@localhost

# Personal Access Token. Create it by hand in Firefly:
# Options > Profile > OAuth > Personal Access Tokens > Create new token.
FIREFLY_ACCESS_TOKEN=

# --- Bridge ---
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bridge
# Sent by API clients as:  Authorization: Bearer <token>
BRIDGE_API_TOKEN=__GENERATE__
