# Copy to .env with:  sh scripts/init-env.sh
# That script fills every __GENERATE__ value with a random secret.
# .env is gitignored. Never commit it.

# --- PostgreSQL (one server, two databases, two roles) ---
POSTGRES_PASSWORD=__GENERATE__
FIREFLY_DB_NAME=firefly
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=__GENERATE__
BRIDGE_DB_NAME=bridge
BRIDGE_DB_USER=bridge
BRIDGE_DB_PASSWORD=__GENERATE__

# --- Firefly III ---
# APP_KEY and STATIC_CRON_TOKEN must be exactly 32 characters.
FIREFLY_APP_KEY=__GENERATE__
FIREFLY_STATIC_CRON_TOKEN=__GENERATE__
FIREFLY_APP_URL=http://localhost:8080
FIREFLY_SITE_OWNER=owner@localhost

# Personal Access Token. Create it by hand in Firefly:
# Options > Profile > OAuth > Personal Access Tokens > Create new token.
FIREFLY_ACCESS_TOKEN=

# --- Bridge ---
DJANGO_SECRET_KEY=__GENERATE__
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bridge
# Sent by API clients as:  Authorization: Bearer <token>
BRIDGE_API_TOKEN=__GENERATE__

# --- SMS forwarder (M2) ---
# The forwarder app signs each request with this (HMAC-SHA-256, X-Signature header).
BRIDGE_SMS_HMAC_SECRET=__GENERATE__

# --- Optional: home Wi-Fi access for the SMS forwarder ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# BRIDGE_LAN_IP=192.168.0.x

# Your own UPI IDs, comma-separated. Payments to or from them are treated as transfers between own accounts.
BRIDGE_OWN_VPAS=

# Banks whose SMS never name the account: profile=last4, comma-separated (e.g. sbi-card=1234,federal=5678).
BRIDGE_DEFAULT_ACCOUNTS=

# --- M3: key for secrets stored in the database (Gmail tokens, statement passwords). Back it up separately.
BRIDGE_ENCRYPTION_KEY=__GENERATE_FERNET__
INGEST_LEDGER_START=2026-11-01

# --- M4: AI. Default is the ollama container (nothing leaves this machine).
# LLM_PROVIDER=ollama | gemini | groq ; LLM_API_KEY only for gemini / groq.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
# A separate Firefly Personal Access Token for the categoriser (revocable on its own).
CATEGORIZER_FIREFLY_TOKEN=
